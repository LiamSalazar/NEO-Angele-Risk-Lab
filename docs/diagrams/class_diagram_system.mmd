classDiagram
    %% Full object-oriented system view.
    %% This diagram separates domain/result objects from process and infrastructure classes.
    %% Names are taken from the current codebase. Some requested concepts are implemented
    %% as functions rather than classes, so they are not modeled here as classes.

    %% Domain and analytical entities, summarized.
    class Asteroid {
        +AsteroidIdentity identity
        +Orbit orbit
        +PhysicalProperties physical
        +CloseApproachSummary close_approach_summary
        +SentryRiskSignal sentry_signal
        +object_key() str
        +to_feature_dict() dict
        +to_dict() dict
    }

    class AsteroidIdentity {
        +str object_key
        +str spkid
        +str des
        +best_identifier() str
    }

    class Orbit {
        +float a
        +float e
        +float i
        +float moid
        +float moid_ld
        +orbital_vector() list
        +proximity_indicator() float
        +uncertainty_indicator() float
    }

    class PhysicalProperties {
        +float h
        +float diameter
        +float albedo
        +size_indicator() float
    }

    class CloseApproachSummary {
        +float min_close_approach_dist
        +float max_close_approach_v_rel
        +int close_approach_count
        +approach_priority_indicator() float
    }

    class SentryRiskSignal {
        +bool sentry_flag
        +float sentry_ip
        +float sentry_ps_max
        +has_sentry_signal() bool
    }

    class RiskScore {
        +str object_key
        +float risk_score_0_100
        +str risk_category
        +component_breakdown() dict
        +dominant_components(top_n) list
    }

    class RiskExplanation {
        +str object_key
        +float risk_score_0_100
        +str risk_category
        +list main_drivers
        +list data_limitations
        +as_markdown() str
    }

    class MonteCarloResult {
        +str object_key
        +float mean_score
        +float p95_score
        +float category_shift_probability
        +stability_summary() dict
    }

    class OrbitalSimulationResult {
        +str object_key
        +float simulated_min_distance_p05_au
        +float dispersion_index
        +str scenario_category
        +bool covariance_available
        +str simulation_method
        +to_dict() dict
    }

    class OrbitalGraph {
        +list nodes
        +list edges
        +node_count() int
        +edge_count() int
        +density() float
        +to_networkx() Graph
    }

    class OrbitalGraphNode {
        +int node_id
        +str object_key
        +dict features
        +object label
        +to_dict() dict
    }

    class OrbitalSimilarityEdge {
        +int source
        +int target
        +float similarity
        +float distance
        +to_dict() dict
    }

    class GNNExperimentResult {
        +str experiment_id
        +str model_name
        +dict metrics
        +dict baseline_metrics
        +str status
        +summary() dict
    }

    class ModelCard {
        +str model_name
        +str model_family
        +str feature_set
        +dict metrics
        +str leakage_risk
        +to_dict() dict
    }

    class PredictionRecord {
        +str object_key
        +int predicted_label
        +float predicted_probability
        +str confidence_bucket
        +to_dict() dict
    }

    class AnalyticalFinding {
        +str title
        +str short_text
        +str technical_basis
        +list related_objects
        +to_dict() dict
    }

    %% Factories and repositories.
    class AsteroidFactory {
        +from_gold_row(row) Asteroid
        +from_risk_row(row) tuple
        +many_from_dataframe(df) list
        +risk_score_from_row(row) RiskScore
        +monte_carlo_result_from_dict(data) MonteCarloResult
    }

    class GoldFeatureRepository {
        +Path gold_root
        +Path features_path
        +load_dataframe() DataFrame
        +load_asteroids() list
        +get_by_object_key(object_key) Asteroid
        +count() int
    }

    class RiskScoreRepository {
        +Path gold_root
        +Path risk_scores_path
        +load_dataframe() DataFrame
        +load_scores() list
        +get_score(object_key) RiskScore
        +top(limit) list
    }

    class SimulationResultRepository {
        +Path gold_root
        +Path simulation_results_path
        +load_latest_results() list
        +get_latest_for_object(object_key) MonteCarloResult
    }

    %% Risk scoring and score simulation process classes.
    class RiskScorer {
        +dict weights
        +RiskCategoryAssigner category_assigner
        +score_dataframe(df) DataFrame
        +score_row(row) dict
        +component_columns() list
        +score_version() str
    }

    class RiskCategoryAssigner {
        +assign(score_0_100) str
        +describe(category) str
        +all_categories() dict
    }

    class RiskExplanationService {
        +explain_row(row) dict
        +identify_main_drivers(row) list
        +identify_protective_factors(row) list
        +identify_data_limitations(row) list
    }

    class RiskRankingService {
        +rank(df, limit) DataFrame
        +top_by_category(df, category, limit) DataFrame
        +get_object(df, object_key) dict
        +summarize_ranking(df) dict
    }

    class RiskReportWriter {
        +Path score_output_dir
        +Path report_dir
        +RiskRankingService ranking
        +score_path() Path
        +save_outputs(scored_df, summary, weights, top_limit) dict
        +write_methodology(weights) Path
    }

    class RiskValidationReporter {
        +Path report_dir
        +write_all(scored_df) dict
        +write_component_formulas() Path
        +write_detailed_methodology() Path
        +write_component_sensitivity(scored_df) tuple
        +write_ablation(scored_df) tuple
    }

    class PerturbationConfig {
        +int n_simulations
        +int random_state
        +bool clip_values
    }

    class PerturbationEngine {
        +list variables
        +dict last_uncertainty_summary
        +perturb_row(row, config, reference_df) DataFrame
        +infer_scale(value, variable_name) float
        +apply_bounds(df) DataFrame
    }

    class UncertaintySpec {
        +str variable_name
        +str distribution_type
        +dict parameters
        +str source
        +bool is_formal_uncertainty
        +to_dict() dict
    }

    class SensitivityAnalyzer {
        +RiskScorer risk_scorer
        +estimate_feature_sensitivity(row, variables, perturbation_pct) list
        +top_sensitivity_factors(row, variables, perturbation_pct, limit) list
    }

    class MonteCarloEngine {
        +RiskScorer risk_scorer
        +PerturbationEngine perturbation_engine
        +SensitivityAnalyzer sensitivity
        +RiskCategoryAssigner categories
        +RiskRankingService ranking
        +simulate_object(row, n_simulations, random_state, reference_df) dict
        +simulate_batch(df, limit, n_simulations, random_state) dict
        +summarize_simulated_scores(simulated_df, base_row) dict
        +simulation_version() str
    }

    class SimulationReportWriter {
        +Path result_output_dir
        +Path report_dir
        +results_path() Path
        +uncertainty_results_path() Path
        +save_outputs(results, source_rows) dict
        +write_methodology() Path
        +write_sensitivity_reports(source_rows) dict
    }

    %% Orbital simulation process classes.
    class OrbitalMonteCarloEngine {
        +simulate_object(row, n_clones, horizon_days, time_step_days, random_state) dict
    }

    class OrbitalSimulationService {
        +Path gold_root
        +Path risk_scores_dir
        +Path output_dir
        +OrbitalMonteCarloEngine engine
        +OrbitalSimulationReportWriter writer
        +results_path() Path
        +load_source_rows() DataFrame
        +simulate_object(object_key, n_clones, horizon_days, time_step_days, random_state) dict
        +simulate_batch(limit, n_clones, horizon_days, time_step_days, random_state) dict
        +latest_for_object(object_key) dict
        +findings() dict
        +status() dict
    }

    class OrbitalSimulationReportWriter {
        +Path output_dir
        +Path report_dir
        +results_path() Path
        +save_outputs(results) dict
    }

    %% GNN and graph process classes.
    class OrbitalSimilarityCalculator {
        +list default_features
        +prepare_similarity_matrix(df, features) ndarray
        +compute_knn_edges(df, k, metric) list
        +compute_radius_edges(df, radius) list
        +normalize_features(df, features) DataFrame
    }

    class OrbitalGraphBuilder {
        +Path gold_root
        +Path report_dir
        +OrbitalSimilarityCalculator similarity
        +build_graph_from_risk_scores(k, target, min_nodes, write_summary) OrbitalGraph
        +build_networkx_graph(graph) Graph
        +export_graph(graph, output_dir) dict
        +graph_summary(graph, status, warnings) dict
    }

    class GNNDatasetBuilder {
        +build_node_feature_matrix(graph) tuple
        +build_edge_index(graph) ndarray
        +build_labels(graph, target) ndarray
        +split_masks(y, train_ratio, val_ratio, random_state) dict
        +to_torch_geometric_data(graph, target, random_state) object
    }

    class GraphBaselineRunner {
        +int random_state
        +FeatureSetRegistry feature_registry
        +run_all(df, target, feature_sets) dict
        +run_logistic_regression_baseline(df, target, feature_set) dict
        +run_random_forest_baseline(df, target, feature_set) dict
        +run_mlp_baseline(df, target, feature_set) dict
        +run_label_propagation_baseline(df, target, feature_set) dict
    }

    class GNNTrainer {
        +train_graphsage(data, epochs, patience, random_state) dict
        +train_gcn(data, epochs, patience, random_state) dict
        +evaluate(model, data, mask_name) dict
        +predict_proba(model, data) ndarray
    }

    class GraphSAGEModel {
        +conv1
        +conv2
        +float dropout
        +forward(x, edge_index) object
    }

    class GCNModel {
        +conv1
        +conv2
        +float dropout
        +forward(x, edge_index) object
    }

    class GNNReportWriter {
        +Path report_dir
        +write_outputs(result) dict
    }

    class GNNExperimentRunner {
        +Path gold_root
        +Path graph_output_dir
        +OrbitalGraphBuilder graph_builder
        +GNNDatasetBuilder dataset_builder
        +GraphBaselineRunner baselines
        +GNNTrainer trainer
        +GNNReportWriter report_writer
        +run_graph_experiment(target, k, min_nodes) dict
        +run_baseline_comparison(df, target) dict
        +run_all(target, k, min_nodes) dict
        +run_graph_k_ablation(target, min_nodes, k_values) dict
    }

    %% ML and model-evidence process classes.
    class FeatureSetDefinition {
        +str name
        +list features
        +str description
    }

    class FeatureSetRegistry {
        +list_feature_sets() list
        +names() list
        +get(name) FeatureSetDefinition
        +resolve(df, feature_set_name, target) dict
    }

    class MLDatasetLoader {
        +Path gold_root
        +features_path() Path
        +load_gold_features() DataFrame
        +validate_target(df, target) dict
        +prepare_training_frame(target, dropna_target) DataFrame
    }

    class RuleBasedPHABaseline {
        +fit(X, y) RuleBasedPHABaseline
        +predict(X) ndarray
        +predict_proba(X) ndarray
    }

    class LeakageAuditor {
        +inspect_feature_leakage(feature_names, target) dict
        +compare_feature_sets(results) dict
        +generate_leakage_report(results, output_dir) Path
    }

    class BaselineExperimentRunner {
        +Path output_dir
        +int random_state
        +MLDatasetLoader loader
        +FeatureSetRegistry feature_sets
        +LeakageAuditor leakage_auditor
        +run_experiment(df, target, feature_set_name, model_name) dict
        +run_all_baselines(target, min_rows, min_positive) dict
    }

    class MLValidationReportBuilder {
        +Path gold_root
        +Path report_dir
        +int random_state
        +MLDatasetLoader loader
        +FeatureSetRegistry feature_sets
        +build(target) dict
    }

    class ModelEvidenceBuilder {
        +Path gold_root
        +Path reports_root
        +Path report_dir
        +build(target, write) dict
        +status() dict
        +read_summary() dict
        +read_cards() dict
        +read_predictions(mode) dict
        +read_disagreements() dict
        +object_evidence(object_key, mode) dict
        +write_outputs(payload, eval_predictions, full_predictions, disagreements, high_confidence, low_confidence, false_positives, false_negatives) dict
    }

    %% Findings process classes.
    class FindingsBuilder {
        +Path gold_root
        +Path reports_root
        +Path report_dir
        +build_all(write) dict
        +status() dict
        +read_group(group_name) dict
        +object_findings(object_key) dict
        +write_outputs(payload) dict
    }

    %% Data ingestion, ETL, storage, clients, and pipelines.
    class APIRequestInfo {
        +dict query_params
        +str object_id
        +dict api_signature
    }

    class IngestionMetadata {
        +str source
        +str ingested_at_utc
    }

    class BronzeRecord {
        +IngestionMetadata metadata
        +dict data
    }

    class BronzeStorage {
        +Path root_dir
        +save_json(source, payload, query_params, object_id) Path
        +list_files(source) list
        +latest_file(source) Path
        +object_exists(source, object_id) bool
        +list_object_ids(source) set
    }

    class SilverStorage {
        +Path root_dir
        +table_path(table_name) Path
        +list_tables() list
    }

    class GoldStorage {
        +Path root_dir
        +table_path(table_name) Path
        +quality_reports_path() Path
        +list_tables() list
        +latest_quality_reports(limit) list
    }

    class BaseJPLClient {
        +str base_url
        +int timeout
        +Session session
        +bool validate_signature
        +int max_retries
        +dict last_request_params
        +str last_request_url
        +build_url(params) str
        +get(params) dict
    }

    class SBDBObjectClient {
        +get_by_search_string(sstr, neo_only) dict
        +get_by_designation(des, neo_only) dict
        +get_by_spk(spk, neo_only) dict
        +get_rich_object(designation_or_name, covariance_format) dict
        +get_with_covariance(designation_or_name, covariance_format) dict
    }

    class SBDBQueryClient {
        +get_count() dict
        +get_fields() dict
        +query_neos(limit, limit_from) dict
        +query_custom(fields, limit, limit_from, sort, extra_params) dict
    }

    class CloseApproachClient {
        +query(date_min, date_max, dist_max, body, neo, pha, limit, sort, diameter, fullname, des, spk) dict
        +query_by_designation(des, date_min, date_max, dist_max) dict
        +query_upcoming_earth_approaches(limit) dict
        +query_pha_approaches(limit) dict
    }

    class SentryClient {
        +get_summary() dict
        +get_object_by_designation(des) dict
        +get_object_by_spk(spk) dict
        +get_virtual_impactors(ip_min) dict
        +get_removed_objects() dict
        +get_high_priority_summary(ip_min, ps_min, h_max) dict
    }

    class BronzeReader {
        +SparkSession spark
        +Path bronze_root
        +read_source(source) DataFrame
        +read_sbdb_object() DataFrame
        +read_cad() DataFrame
        +read_sentry() DataFrame
        +read_sbdb_query() DataFrame
        +source_exists(source) bool
        +list_available_sources() list
    }

    class SilverTransformers {
        +SparkSession spark
        +transform_sbdb_objects(bronze_df) DataFrame
        +transform_close_approaches(bronze_df) DataFrame
        +transform_sentry_objects(bronze_df) DataFrame
        +transform_sentry_virtual_impactors(bronze_df) DataFrame
        +transform_ingestion_events(bronze_df) DataFrame
    }

    class GoldBuilder {
        +SparkSession spark
        +Path silver_root
        +Path gold_root
        +build_neo_risk_features() DataFrame
    }

    class DataQualityChecker {
        +check_required_columns(df, required_columns) dict
        +check_non_empty(df, dataset_name) dict
        +check_null_ratio(df, columns) dict
        +check_duplicate_keys(df, key_columns) dict
        +check_numeric_ranges(df, rules) dict
        +run_gold_quality_checks(df) dict
        +write_quality_report(report, gold_root) Path
    }

    class ParquetTableWriter {
        +write(df, output_path, mode, skip_empty) dict
    }

    class RunManifest {
        +str run_id
        +str run_type
        +str started_at_utc
        +str ended_at_utc
        +str status
        +dict inputs
        +dict outputs
        +dict metrics
        +list warnings
        +list errors
        +to_dict() dict
    }

    class IngestionPipeline {
        +SBDBQueryClient sbdb_query_client
        +SBDBObjectClient sbdb_object_client
        +CloseApproachClient close_approach_client
        +SentryClient sentry_client
        +BronzeStorage bronze_storage
        +list last_failures
        +ingest_sbdb_query_sample(limit) Path
        +ingest_object(designation_or_name, rich) Path
        +ingest_cad_sample(date_min, date_max, dist_max, limit) Path
        +ingest_sentry_summary() Path
        +ingest_sentry_virtual_impactors(ip_min) Path
        +ingest_discovered_objects(strategy, limit, rich, skip_existing, request_delay_seconds) dict
        +ingest_max_available_objects(target, rich, skip_existing, resume, batch_size, request_delay_seconds) dict
    }

    class ETLPipeline {
        +SparkSession spark
        +Path bronze_root
        +Path silver_root
        +Path gold_root
        +BronzeReader reader
        +SilverTransformers transformers
        +ParquetTableWriter writer
        +SilverStorage silver_storage
        +GoldStorage gold_storage
        +DataQualityChecker quality
        +run_bronze_to_silver(source) dict
        +run_gold(min_rows_for_ml, min_positive_class_count, target) dict
        +run_all(min_rows_for_ml, min_positive_class_count, target) dict
    }

    class RiskPipeline {
        +Path gold_root
        +Path features_path
        +Path risk_output_dir
        +RiskScorer scorer
        +RiskRankingService ranking
        +RiskExplanationService explanations
        +RiskReportWriter report_writer
        +risk_scores_path() Path
        +load_gold_features() DataFrame
        +load_risk_scores() DataFrame
        +build_scores() dict
        +top(limit) list
        +explain(object_key) dict
        +status() dict
        +categories() dict
        +methodology() dict
    }

    class SimulationPipeline {
        +Path gold_root
        +Path risk_scores_dir
        +Path simulation_output_dir
        +MonteCarloEngine engine
        +SimulationReportWriter report_writer
        +risk_scores_path() Path
        +simulation_results_path() Path
        +load_risk_scores() DataFrame
        +simulate_object(object_key, n_simulations, random_state) dict
        +simulate_batch(limit, n_simulations, random_state) dict
        +latest_for_object(object_key) dict
        +methodology() dict
    }

    class MLPipeline {
        +Path gold_root
        +Path output_dir
        +Path model_dir
        +int random_state
        +run_baselines(target, min_rows, min_positive) dict
        +run_leakage_audit(target) dict
        +run_all(target, min_rows, min_positive) dict
    }

    %% Entity containment and result references.
    Asteroid *-- AsteroidIdentity : identity
    Asteroid *-- Orbit : orbit
    Asteroid *-- PhysicalProperties : physical
    Asteroid o-- CloseApproachSummary : close_approach_summary
    Asteroid o-- SentryRiskSignal : sentry_signal
    RiskScore ..> Asteroid : object_key
    RiskExplanation ..> RiskScore : explains
    MonteCarloResult ..> RiskScore : score distribution
    OrbitalSimulationResult ..> Orbit : orbital state
    OrbitalSimulationResult ..> RiskScore : score context
    OrbitalGraph *-- OrbitalGraphNode : nodes
    OrbitalGraph *-- OrbitalSimilarityEdge : edges
    OrbitalSimilarityEdge ..> OrbitalGraphNode : source target ids
    GNNExperimentResult ..> OrbitalGraph : summarizes
    PredictionRecord ..> RiskScore : score context
    PredictionRecord ..> ModelCard : model context
    AnalyticalFinding ..> RiskScore : related objects

    %% Factories and repositories.
    AsteroidFactory ..> Asteroid : creates
    AsteroidFactory ..> AsteroidIdentity : creates
    AsteroidFactory ..> Orbit : creates
    AsteroidFactory ..> PhysicalProperties : creates
    AsteroidFactory ..> CloseApproachSummary : creates
    AsteroidFactory ..> SentryRiskSignal : creates
    AsteroidFactory ..> RiskScore : creates
    AsteroidFactory ..> MonteCarloResult : creates
    GoldFeatureRepository ..> AsteroidFactory : maps rows
    RiskScoreRepository ..> AsteroidFactory : maps rows
    SimulationResultRepository ..> AsteroidFactory : maps rows
    GoldFeatureRepository --> Asteroid : returns
    RiskScoreRepository --> RiskScore : returns
    SimulationResultRepository --> MonteCarloResult : returns

    %% Risk and score simulation relationships.
    RiskScorer *-- RiskCategoryAssigner : category_assigner
    RiskScorer ..> RiskExplanationService : builds explanation text
    RiskScorer ..> Asteroid : accepts aggregate
    RiskScorer ..> RiskScore : derives score fields
    RiskExplanationService ..> Asteroid : accepts
    RiskExplanationService ..> RiskScore : accepts
    RiskExplanationService ..> RiskExplanation : payload shape
    RiskRankingService ..> RiskScore : ranks scored rows
    RiskReportWriter *-- RiskRankingService : ranking
    RiskValidationReporter ..> RiskScorer : validates outputs
    PerturbationEngine ..> PerturbationConfig : uses
    PerturbationEngine ..> UncertaintySpec : uncertainty metadata
    SensitivityAnalyzer *-- RiskScorer : risk_scorer
    MonteCarloEngine *-- RiskScorer : risk_scorer
    MonteCarloEngine *-- PerturbationEngine : perturbation_engine
    MonteCarloEngine *-- SensitivityAnalyzer : sensitivity
    MonteCarloEngine *-- RiskCategoryAssigner : categories
    MonteCarloEngine *-- RiskRankingService : ranking
    MonteCarloEngine ..> MonteCarloResult : summarizes samples
    SimulationReportWriter ..> MonteCarloResult : persists

    %% Orbital simulation relationships.
    OrbitalMonteCarloEngine --> OrbitalSimulationResult : creates
    OrbitalSimulationService *-- OrbitalMonteCarloEngine : engine
    OrbitalSimulationService *-- OrbitalSimulationReportWriter : writer
    OrbitalSimulationService ..> RunManifest : saves
    OrbitalSimulationReportWriter ..> OrbitalSimulationResult : persists

    %% Graph, GNN, ML, evidence, and findings relationships.
    OrbitalGraphBuilder *-- OrbitalSimilarityCalculator : similarity
    OrbitalGraphBuilder --> OrbitalGraph : builds
    OrbitalGraphBuilder --> OrbitalGraphNode : builds
    OrbitalSimilarityCalculator --> OrbitalSimilarityEdge : computes
    GNNDatasetBuilder ..> OrbitalGraph : converts
    GraphBaselineRunner *-- FeatureSetRegistry : feature_registry
    GNNTrainer ..> GraphSAGEModel : trains
    GNNTrainer ..> GCNModel : trains
    GNNExperimentRunner *-- OrbitalGraphBuilder : graph_builder
    GNNExperimentRunner *-- GNNDatasetBuilder : dataset_builder
    GNNExperimentRunner *-- GraphBaselineRunner : baselines
    GNNExperimentRunner *-- GNNTrainer : trainer
    GNNExperimentRunner *-- GNNReportWriter : report_writer
    GNNExperimentRunner ..> GNNExperimentResult : result envelope
    GNNExperimentRunner ..> RunManifest : saves
    FeatureSetRegistry *-- FeatureSetDefinition : definitions
    MLDatasetLoader ..> GoldStorage : reads gold root
    BaselineExperimentRunner *-- MLDatasetLoader : loader
    BaselineExperimentRunner *-- FeatureSetRegistry : feature_sets
    BaselineExperimentRunner *-- LeakageAuditor : leakage_auditor
    BaselineExperimentRunner ..> RuleBasedPHABaseline : baseline option
    MLValidationReportBuilder *-- MLDatasetLoader : loader
    MLValidationReportBuilder *-- FeatureSetRegistry : feature_sets
    MLPipeline ..> BaselineExperimentRunner : runs
    MLPipeline ..> LeakageAuditor : runs
    MLPipeline ..> MLValidationReportBuilder : builds validation
    MLPipeline ..> RunManifest : saves
    ModelEvidenceBuilder ..> MLValidationReportBuilder : builds validation reports
    ModelEvidenceBuilder --> ModelCard : writes
    ModelEvidenceBuilder --> PredictionRecord : writes
    FindingsBuilder --> AnalyticalFinding : writes
    FindingsBuilder ..> RiskScore : reads risk artifacts
    FindingsBuilder ..> MonteCarloResult : reads score simulations
    FindingsBuilder ..> OrbitalSimulationResult : reads orbital simulations
    FindingsBuilder ..> OrbitalGraph : reads graph artifacts
    FindingsBuilder ..> ModelEvidenceBuilder : reads evidence artifacts

    %% Ingestion, ETL, storage, and pipeline relationships.
    APIRequestInfo <|-- IngestionMetadata
    BronzeRecord *-- IngestionMetadata : metadata
    BronzeStorage ..> BronzeRecord : writes JSON wrapper
    BronzeReader ..> BronzeStorage : reads files
    SilverTransformers ..> BronzeRecord : transforms payloads
    GoldBuilder ..> SilverStorage : reads silver tables
    DataQualityChecker ..> GoldBuilder : validates outputs
    ParquetTableWriter ..> SilverStorage : writes tables
    ParquetTableWriter ..> GoldStorage : writes tables
    BaseJPLClient <|-- SBDBObjectClient
    BaseJPLClient <|-- SBDBQueryClient
    BaseJPLClient <|-- CloseApproachClient
    BaseJPLClient <|-- SentryClient
    IngestionPipeline *-- SBDBQueryClient : sbdb_query_client
    IngestionPipeline *-- SBDBObjectClient : sbdb_object_client
    IngestionPipeline *-- CloseApproachClient : close_approach_client
    IngestionPipeline *-- SentryClient : sentry_client
    IngestionPipeline *-- BronzeStorage : bronze_storage
    ETLPipeline *-- BronzeReader : reader
    ETLPipeline *-- SilverTransformers : transformers
    ETLPipeline *-- ParquetTableWriter : writer
    ETLPipeline *-- SilverStorage : silver_storage
    ETLPipeline *-- GoldStorage : gold_storage
    ETLPipeline *-- DataQualityChecker : quality
    ETLPipeline ..> GoldBuilder : builds gold features
    RiskPipeline *-- RiskScorer : scorer
    RiskPipeline *-- RiskRankingService : ranking
    RiskPipeline *-- RiskExplanationService : explanations
    RiskPipeline *-- RiskReportWriter : report_writer
